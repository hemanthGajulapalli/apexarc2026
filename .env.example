# Copy to .env and adjust for your environment. Loaded by deploy/config.py
# (python-dotenv); real deployment secrets should come from the pipeline's
# own secret store (ADR020), not a committed .env file — this is for local
# use only. Any value here can also be set as a real environment variable
# with a VDE_ prefix, e.g. VDE_DB_HOST, VDE_API_BASE_URL — env vars win.

VDE_DB_HOST=localhost
VDE_DB_PORT=5433
VDE_DB_USER=vondigitalis
VDE_DB_NAME=von_digitalis
VDE_API_BASE_URL=http://localhost:4000
